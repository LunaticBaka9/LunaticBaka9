---
/**
 * 模块用途：
 *   博客文章详情页专属排版布局（PostLayout），呈现复古档案元信息区、舒适行宽（68ch）
 *   正文阅读器以及底部“上一篇 / 下一篇”与分类/时间轴快速导航。
 *   所有文章元信息、阅读统计与上下篇链接均通过 Props 注入，不在布局内做数据查询。
 *
 * 使用方法：
 *   <PostLayout
 *     title={post.data.title}
 *     description={post.data.description}
 *     pubDate={post.data.pubDate}
 *     category={category}
 *     tags={post.data.tags}
 *     wordCount={stats.wordCount}
 *     readingTimeLabel={stats.label}
 *     prevPost={prevLink}
 *     nextPost={nextLink}
 *   >
 *     <Content />
 *   </PostLayout>
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import WindowCard from '../components/WindowCard.astro';
import { SITE_TITLE } from '../consts';
import { toCategorySlug } from '../utils/blogService';
import { withBase } from '../utils/paths';
import BaseLayout from './BaseLayout.astro';

export interface AdjacentPostLink {
	title: string;
	href: string;
}

export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	category: string;
	tags?: string[];
	wordCount: number;
	readingTimeLabel: string;
	prevPost?: AdjacentPostLink | null;
	nextPost?: AdjacentPostLink | null;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	wordCount,
	readingTimeLabel,
	prevPost = null,
	nextPost = null,
} = Astro.props;

const categoryHref = withBase(`/blog/categories/${toCategorySlug(category)}/`);
---

<BaseLayout title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage}>
	<div class="post-shell">
		<WindowCard title={`~/blog/archive/${category}`} status={readingTimeLabel} as="article">
			<a slot="header-actions" class="header-back" href={withBase('/blog')}>← 返回列表</a>

			<header class="post-header">
				<h1 class="post-title">{title}</h1>
				<p class="post-desc">{description}</p>

				<div class="post-meta">
					<span class="meta-item">
						<span class="meta-key">DATE</span>
						<FormattedDate date={pubDate} />
					</span>
					{
						updatedDate && (
							<span class="meta-item">
								<span class="meta-key">UPDATED</span>
								<FormattedDate date={updatedDate} />
							</span>
						)
					}
					<span class="meta-item">
						<span class="meta-key">WORDS</span>
						<span>{wordCount} 字 · {readingTimeLabel}</span>
					</span>
					<a class="retro-tag retro-tag--accent" href={categoryHref}>#{category}</a>
				</div>

				{
					tags.length > 0 && (
						<ul class="tag-list" aria-label="文章标签">
							{tags.map((tag) => (
								<li class="retro-tag">{tag}</li>
							))}
						</ul>
					)
				}
			</header>

			{
				heroImage && (
					<div class="hero-image">
						<Image width={960} height={480} src={heroImage} alt={title} />
					</div>
				)
			}

			<hr />

			<div class="retro-prose post-content">
				<slot />
			</div>
		</WindowCard>

		<WindowCard title="~/blog/navigation.sh" status="NAV" as="nav">
			<div class="post-nav-grid">
				<div class="nav-slot">
					{
						prevPost ? (
							<a class="nav-link" href={prevPost.href}>
								<span class="nav-label">← 上一篇（更新）</span>
								<span class="nav-title">{prevPost.title}</span>
							</a>
						) : (
							<div class="nav-empty">← 已是最新一篇</div>
						)
					}
				</div>

				<div class="nav-slot nav-slot--right">
					{
						nextPost ? (
							<a class="nav-link nav-link--right" href={nextPost.href}>
								<span class="nav-label">下一篇（更早） →</span>
								<span class="nav-title">{nextPost.title}</span>
							</a>
						) : (
							<div class="nav-empty">已是更早的终点 →</div>
						)
					}
				</div>
			</div>

			<div class="nav-shortcuts">
				<a class="retro-btn" href={categoryHref}>查看「{category}」全部分类</a>
				<a class="retro-btn" href={withBase('/timeline')}>查看时间轴归档</a>
				<a class="retro-btn" href={withBase('/blog')}>返回全部文章</a>
			</div>
		</WindowCard>
	</div>
</BaseLayout>

<style>
	.post-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.header-back {
		color: var(--retro-accent);
		text-decoration: none;
	}

	.header-back:hover {
		text-decoration: underline;
	}

	.post-header {
		max-width: var(--retro-prose-width);
		margin: 0 auto 1.25rem;
	}

	.post-title {
		margin: 0 0 0.6rem;
	}

	.post-desc {
		margin: 0 0 1rem;
		color: var(--retro-muted);
		font-size: 0.98rem;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--retro-muted);
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.meta-key {
		color: var(--retro-signal);
		font-weight: 600;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0.85rem 0 0;
		padding: 0;
	}

	.hero-image {
		max-width: var(--retro-prose-width);
		margin: 1rem auto 0;
		border: 1px solid var(--retro-border);
		border-radius: var(--retro-radius);
		overflow: hidden;
	}

	.hero-image img {
		display: block;
		width: 100%;
		border-radius: 0;
	}

	.post-content {
		padding: 0.5rem 0 0.75rem;
	}

	.post-nav-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--retro-border);
		border-radius: var(--retro-radius);
		background: var(--retro-panel-alt);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	.nav-link:hover {
		border-color: var(--retro-accent);
	}

	.nav-link--right {
		text-align: right;
	}

	.nav-label {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--retro-muted);
	}

	.nav-title {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		color: var(--retro-heading);
	}

	.nav-empty {
		padding: 0.75rem 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--retro-muted);
		border: 1px dashed var(--retro-border);
		border-radius: var(--retro-radius);
	}

	.nav-slot--right .nav-empty {
		text-align: right;
	}

	.nav-shortcuts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--retro-border);
	}

	@media (max-width: 640px) {
		.post-nav-grid {
			grid-template-columns: 1fr;
		}
		.nav-link--right,
		.nav-slot--right .nav-empty {
			text-align: left;
		}
	}
</style>
