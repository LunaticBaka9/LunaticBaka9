---
/**
 * 模块用途：
 *   博客分类专属静态页（/blog/categories/[category]）。
 *   在构建期为每个文章分类生成独立静态归档页，提供主题分流与分类间快速切换。
 *
 * 使用方法：
 *   由 Astro 动态静态路由自动生成，访问路径如 `/blog/categories/游戏机制/`。
 */

import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import WindowCard from '../../../components/WindowCard.astro';
import { SITE_TITLE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
	extractCategories,
	filterPostsByCategory,
	sortPostsByDate,
	toCategorySlug,
	type CategorySummary,
} from '../../../utils/blogService';
import { withBase } from '../../../utils/paths';
import { estimateReadingTime } from '../../../utils/readingTime';

export async function getStaticPaths() {
	const sortedPosts = sortPostsByDate(await getCollection('blog'));
	const categories = extractCategories(sortedPosts);

	return categories.map((cat) => ({
		params: { category: toCategorySlug(cat.name) },
		props: {
			categoryName: cat.name,
			categories,
			posts: filterPostsByCategory(sortedPosts, cat.name),
		},
	}));
}

interface Props {
	categoryName: string;
	categories: CategorySummary[];
	posts: CollectionEntry<'blog'>[];
}

const { categoryName, categories, posts } = Astro.props;
---

<BaseLayout
	title={`分类：${categoryName} | ${SITE_TITLE}`}
	description={`查看「${categoryName}」分类下的全部博客文章（共 ${posts.length} 篇）。`}
>
	<div class="category-page">
		<WindowCard
			title={`~/blog/categories/${categoryName}`}
			status={`${posts.length} POSTS`}
		>
			<a slot="header-actions" class="header-link" href={withBase('/blog')}>
				← 全部文章
			</a>

			<h1 class="page-title">分类：{categoryName}</h1>

			<nav class="category-nav" aria-label="切换其他分类">
				<a class="retro-tag" href={withBase('/blog')}>全部</a>
				{
					categories.map((cat) => (
						<a
							class:list={[
								'retro-tag',
								{ 'retro-tag--accent': cat.name === categoryName },
							]}
							href={withBase(`/blog/categories/${toCategorySlug(cat.name)}/`)}
						>
							#{cat.name} ({cat.count})
						</a>
					))
				}
			</nav>
		</WindowCard>

		<WindowCard title={`ls ./${categoryName}/*.md`} status="ARCHIVE">
			<ul class="post-list">
				{
					posts.map((post) => {
						const reading = estimateReadingTime(post.body ?? '');
						return (
							<li class="post-item">
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span>·</span>
									<span>{reading.label}</span>
								</div>
								<h2 class="post-title">
									<a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
								</h2>
								<p class="post-desc">{post.data.description}</p>
							</li>
						);
					})
				}
			</ul>
		</WindowCard>
	</div>
</BaseLayout>

<style>
	.category-page {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.header-link {
		color: var(--retro-accent);
		text-decoration: none;
	}

	.header-link:hover {
		text-decoration: underline;
	}

	.page-title {
		margin: 0 0 0.85rem;
	}

	.category-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.post-item {
		padding: 0.9rem 1rem;
		background: var(--retro-panel-alt);
		border: 1px solid var(--retro-border);
		border-radius: var(--retro-radius);
		transition: border-color 0.15s ease;
	}

	.post-item:hover {
		border-color: var(--retro-accent);
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--retro-muted);
	}

	.post-title {
		margin: 0 0 0.3rem;
		font-size: 1.08rem;
	}

	.post-title a {
		color: var(--retro-heading);
		text-decoration: none;
	}

	.post-title a:hover {
		color: var(--retro-accent);
	}

	.post-desc {
		margin: 0;
		font-size: 0.92rem;
		color: var(--retro-muted);
	}
</style>
