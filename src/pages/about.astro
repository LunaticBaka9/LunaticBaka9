---
/**
 * 模块用途：
 *   关于页面（/about），复用 `BaseLayout` 与 `WindowCard` 保持全站极客复古视觉一致性。
 *
 * 使用方法：
 *   由 Astro 路由映射至 `/about`，直接展示 `consts.ts` 中的个人定位与折腾方向。
 */

import WindowCard from '../components/WindowCard.astro';
import { PROFILE, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`关于我 | ${SITE_TITLE}`} description={PROFILE.tagline}>
	<WindowCard title="~/about.txt" status={PROFILE.status}>
		<h1>关于 {SITE_TITLE}</h1>
		<p>{PROFILE.tagline}</p>

		<h2>当前折腾方向</h2>
		<ul>
			{PROFILE.focusAreas.map((area) => <li>{area}</li>)}
		</ul>

		<h2>常用技术栈</h2>
		<div class="tags">
			{PROFILE.stack.map((tech) => <span class="retro-tag">{tech}</span>)}
		</div>

		<h2>找到我</h2>
		<div class="links">
			{
				SOCIAL_LINKS.map((link) => (
					<a class="retro-btn" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.name} ↗
					</a>
				))
			}
		</div>
	</WindowCard>
</BaseLayout>

<style>
	.tags,
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
</style>
