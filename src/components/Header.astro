---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';
import HeaderLink from './HeaderLink.astro';
import Icon from './icons/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2>
			<a href={withBase('/')}>{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/about">关于我</HeaderLink>
		</div>
		<div class="header-actions">
			<ThemeToggle />
			<div class="social-links">
				<a href="https://space.bilibili.com/97139029" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Follow Me on Bilibili</span>
					<Icon name="bilibili" size={32} />
				</a>
				<a href="https://twitter.com/Lunaticbaka9" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Follow Me on Twitter</span>
					<Icon name="twitter" size={32} />
				</a>
				<a href="https://github.com/LunaticBaka9" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Go to LunaticBaka9's GitHub repo</span>
					<Icon name="github" size={32} />
				</a>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
		box-shadow: var(--header-shadow);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
