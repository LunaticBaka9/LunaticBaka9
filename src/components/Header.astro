---
/**
 * 模块用途：
 *   极客复古顶部状态栏 / 终端路径导航组件（Header）。
 *   支持通过 Props 注入站点标题、导航项与社交链接，默认读取 `consts.ts` 的全局配置。
 *
 * 使用方法：
 *   <Header />
 *   或显式注入导航项：<Header navItems={customNav} siteTitle="MySite" />
 */

import { NAV_ITEMS, SITE_TITLE, SOCIAL_LINKS, type NavItem, type SocialLink } from '../consts';
import { withBase } from '../utils/paths';
import HeaderLink from './HeaderLink.astro';
import Icon from './icons/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
	siteTitle?: string;
	navItems?: readonly NavItem[];
	socialLinks?: readonly SocialLink[];
}

const {
	siteTitle = SITE_TITLE,
	navItems = NAV_ITEMS,
	socialLinks = SOCIAL_LINKS,
} = Astro.props;
---

<header class="site-header">
	<nav class="site-nav" aria-label="主导航">
		<a class="brand" href={withBase('/')}>
			<span class="brand-prompt" aria-hidden="true">&gt;_</span>
			<span class="brand-name">{siteTitle}</span>
		</a>

		<div class="internal-links">
			{navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>

		<div class="header-actions">
			<ThemeToggle />
			<div class="social-links">
				{
					socialLinks.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							title={link.name}
						>
							<span class="sr-only">{link.ariaLabel}</span>
							<Icon name={link.icon} size={20} />
						</a>
					))
				}
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--retro-panel);
		border-bottom: 1px solid var(--retro-border-strong);
		box-shadow: var(--header-shadow);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.site-nav {
		max-width: var(--retro-max-width);
		margin: 0 auto;
		padding: 0.55rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.96rem;
		font-weight: 700;
		color: var(--retro-heading);
		text-decoration: none;
	}

	.brand-prompt {
		color: var(--retro-signal);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
	}

	.internal-links :global(a) {
		padding: 0.3rem 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.86rem;
		color: var(--retro-muted);
		border: 1px solid transparent;
		border-radius: var(--retro-radius);
		text-decoration: none;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--retro-heading);
		background: var(--retro-panel-alt);
		border-color: var(--retro-border);
	}

	.internal-links :global(a.active) {
		color: var(--retro-accent);
		background: var(--retro-accent-soft);
		border-color: var(--retro-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.32rem;
		color: var(--retro-muted);
		border: 1px solid transparent;
		border-radius: var(--retro-radius);
		text-decoration: none;
	}

	.social-links a:hover {
		color: var(--retro-heading);
		border-color: var(--retro-border);
		background: var(--retro-panel-alt);
	}

	@media (max-width: 760px) {
		.site-nav {
			padding: 0.5rem 0.9rem;
		}
		.social-links {
			display: none;
		}
		.internal-links {
			order: 3;
			width: 100%;
			padding-top: 0.45rem;
			border-top: 1px dashed var(--retro-border);
		}
	}
</style>
