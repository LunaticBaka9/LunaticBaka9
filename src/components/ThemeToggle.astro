---
import Icon from './icons/Icon.astro';
---

<button
	id="theme-toggle"
	type="button"
	class="theme-toggle"
	aria-label="切换主题"
	title="切换亮色 / 暗黑模式"
>
	<!-- 亮色模式下显示太阳图标 -->
	<Icon name="sun" size={18} class="icon icon-sun" />
	<!-- 黑夜模式下显示月亮图标 -->
	<Icon name="moon" size={18} class="icon icon-moon" />
	<span class="label label-night">Night</span>
	<span class="label label-light">Light</span>
</button>

<script>
	function initThemeToggle() {
		const button = document.getElementById('theme-toggle');
		if (!button) return;

		const getTheme = (): 'night' | 'light' =>
			document.documentElement.dataset.theme === 'light' ? 'light' : 'night';

		const syncButtonState = (theme: 'night' | 'light') => {
			button.setAttribute('aria-pressed', String(theme === 'night'));
			button.setAttribute(
				'aria-label',
				theme === 'night' ? '当前为黑夜模式，点击切换到亮色模式' : '当前为亮色模式，点击切换到黑夜模式',
			);
		};

		syncButtonState(getTheme());

		button.addEventListener('click', () => {
			const nextTheme: 'night' | 'light' = getTheme() === 'night' ? 'light' : 'night';
			document.documentElement.dataset.theme = nextTheme;
			localStorage.setItem('theme', nextTheme);
			syncButtonState(nextTheme);
		});
	}

	initThemeToggle();
	document.addEventListener('astro:after-swap', initThemeToggle);
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: rgb(var(--black));
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.15s ease;
	}

	.theme-toggle:hover {
		background: var(--surface-hover);
		border-color: var(--accent);
	}

	.theme-toggle:active {
		transform: scale(0.96);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* 默认（night）状态下展示月亮图标与 Night 标签，切换至 light 后展示太阳图标与 Light 标签 */
	.theme-toggle :global(.icon-sun),
	.label-light {
		display: none;
	}

	.theme-toggle :global(.icon-moon),
	.label-night {
		display: inline-block;
	}

	:global(html[data-theme='light']) .theme-toggle :global(.icon-sun),
	:global(html[data-theme='light']) .label-light {
		display: inline-block;
	}

	:global(html[data-theme='light']) .theme-toggle :global(.icon-moon),
	:global(html[data-theme='light']) .label-night {
		display: none;
	}

	@media (max-width: 520px) {
		.theme-toggle {
			padding: 0.45rem;
		}
		.label {
			display: none !important;
		}
	}
</style>
