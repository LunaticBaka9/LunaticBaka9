---
/**
 * 模块用途：
 *   作品展示卡片组件（ProjectCard），用于在首页“精选作品区”与 `/projects` 归档页展示单个项目。
 *   严格遵守单一职责：仅负责 UI 呈现，所有项目信息与文案映射均通过 Props 注入，不直接读取内容集合。
 *
 * 使用方法：
 *   <ProjectCard
 *     title="Farkle Backpack Prototype"
 *     summary="融合 Farkle 骰子计分与背包空间联动的 Roguelike 网页原型。"
 *     status="active"
 *     stack={['Vue 3', 'TypeScript', 'Pinia']}
 *     demoUrl="https://example.com"
 *     repoUrl="https://github.com/LunaticBaka9/..."
 *     notes="使用状态机拆分掷骰、锁定与计分阶段，避免 UI 与规则耦合。"
 *     showNotes={true}
 *   />
 */

export type ProjectStatus = 'active' | 'wip' | 'archived';

export interface Props {
	/** 项目标题 */
	title: string;
	/** 一句话玩法或核心作用说明 */
	summary: string;
	/** 项目当前状态 */
	status?: ProjectStatus;
	/** 技术栈标签列表 */
	stack?: string[];
	/** 在线 Demo 链接（可选） */
	demoUrl?: string;
	/** 源码仓库链接（可选） */
	repoUrl?: string;
	/** 架构说明、核心机制或踩坑摘要（可选） */
	notes?: string;
	/** 是否展开显示 notes 摘要（首页精选默认关闭，作品集归档页可开启） */
	showNotes?: boolean;
	/** 状态展示文本映射（支持外部覆写，默认提供极客终端标签） */
	statusLabels?: Record<ProjectStatus, string>;
}

const DEFAULT_STATUS_LABELS: Record<ProjectStatus, string> = {
	active: 'ACTIVE',
	wip: 'WIP',
	archived: 'ARCHIVED',
};

const {
	title,
	summary,
	status = 'active',
	stack = [],
	demoUrl,
	repoUrl,
	notes,
	showNotes = false,
	statusLabels = DEFAULT_STATUS_LABELS,
} = Astro.props;
---

<article class="project-card">
	<header class="project-header">
		<h3 class="project-title">{title}</h3>
		<span class:list={['status-badge', `status-badge--${status}`]}>
			{statusLabels[status]}
		</span>
	</header>

	<p class="project-summary">{summary}</p>

	{
		showNotes && notes && (
			<p class="project-notes">
				<span class="notes-prefix">&gt;</span> {notes}
			</p>
		)
	}

	{
		stack.length > 0 && (
			<ul class="stack-list" aria-label="技术栈">
				{stack.map((tech) => (
					<li class="retro-tag">{tech}</li>
				))}
			</ul>
		)
	}

	{
		(demoUrl || repoUrl) && (
			<footer class="project-links">
				{demoUrl && (
					<a class="retro-btn" href={demoUrl} target="_blank" rel="noopener noreferrer">
						▶ Play
					</a>
				)}
				{repoUrl && (
					<a class="retro-btn" href={repoUrl} target="_blank" rel="noopener noreferrer">
						&lt;/&gt; 源码
					</a>
				)}
			</footer>
		)
	}
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem 1.1rem;
		background: var(--retro-panel-alt);
		border: 1px solid var(--retro-border);
		border-radius: var(--retro-radius);
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.project-card:hover {
		border-color: var(--retro-accent);
		transform: translateY(-1px);
	}

	.project-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.project-title {
		margin: 0;
		font-size: 1.05rem;
		color: var(--retro-heading);
	}

	.status-badge {
		flex-shrink: 0;
		padding: 0.12rem 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		border: 1px solid var(--retro-border-strong);
		border-radius: 2px;
		color: var(--retro-muted);
	}

	.status-badge--active {
		color: var(--retro-signal);
		border-color: var(--retro-signal);
	}

	.status-badge--wip {
		color: var(--retro-warn);
		border-color: var(--retro-warn);
	}

	.project-summary {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.65;
		color: var(--retro-text);
	}

	.project-notes {
		margin: 0;
		padding: 0.55rem 0.75rem;
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--retro-muted);
		background: var(--retro-panel);
		border-left: 2px solid var(--retro-border-strong);
	}

	.notes-prefix {
		font-family: var(--font-mono);
		color: var(--retro-accent);
		margin-right: 0.25rem;
	}

	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 0.35rem;
	}
</style>
